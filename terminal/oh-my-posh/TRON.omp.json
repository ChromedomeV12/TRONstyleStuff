{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "upgrade": { "auto": false, "notice": false },
  "console_title_template": "{{ .Folder }} | ENCOM",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#78DDFF",
          "template": "╭─[<#D8E1DD>ENCOM</>]"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#6FC3DF",
          "template": "<#78DDFF>─[</>{{ .Path }}<#78DDFF>]</>",
          "options": { "style": "agnoster_short", "max_depth": 2, "folder_separator_icon": "/", "home_icon": "~", "hide_root_location": false }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#D8E1DD",
          "template": "<#78DDFF>─[</>{{ .HEAD }}{{ if .Working.Changed }}<#FF8C1A> ●{{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<#FF8C1A> +{{ .Staging.String }}</>{{ end }}{{ if gt .Ahead 0 }}<#6FC3DF> ↑{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#FF8C1A> ↓{{ .Behind }}</>{{ end }}<#78DDFF>]</>",
          "options": { "fetch_status": true, "fetch_upstream_icon": false, "fetch_stash_count": false, "branch_icon": "", "commit_icon": "@", "tag_icon": "tag:", "native_git": true },
          "timeout": 150
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#FF8C1A",
          "template": " <#287085>│</> {{ .FormattedMs }}",
          "options": { "threshold": 1500, "style": "austin" }
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "#FFE600",
          "template": " [ROOT]"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#78DDFF",
          "foreground_templates": ["{{ if gt .Code 0 }}#FF6B4A{{ end }}"],
          "template": "╰─{{ if gt .Code 0 }}[exit {{ .Code }}]─{{ end }}❯",
          "options": { "always_enabled": true }
        }
      ]
    }
  ],
  "secondary_prompt": { "foreground": "#6FC3DF", "background": "transparent", "template": "  ┆ " }
}
