<!--
Name: TRON
IsDark: True
HasBlur: False
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <system:Boolean x:Key="ThemeBlurEnabled">False</system:Boolean>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="DarkBG">#050E14</Color>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor" Color="#123446" />
    <CornerRadius x:Key="ItemRadius">4</CornerRadius>

    <Style x:Key="WindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="#050E14" />
        <Setter Property="BorderBrush" Value="#00EEEE" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="WindowStyle" BasedOn="{StaticResource BaseWindowStyle}" TargetType="Window">
        <Setter Property="Width" Value="576" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>
    <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryBoxStyle}" TargetType="TextBox">
        <Setter Property="Background" Value="#050E14" />
        <Setter Property="Foreground" Value="#D8E1DD" />
        <Setter Property="CaretBrush" Value="#00EEEE" />
        <Setter Property="SelectionBrush" Value="#287A9B" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Padding" Value="0 4 66 0" />
        <Setter Property="Height" Value="42" />
    </Style>
    <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}" TargetType="TextBox">
        <Setter Property="Background" Value="#050E14" />
        <Setter Property="Foreground" Value="#788B9F" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Padding" Value="0 4 66 0" />
        <Setter Property="Height" Value="42" />
    </Style>
    <Style x:Key="SearchIconStyle" BasedOn="{StaticResource BaseSearchIconStyle}" TargetType="Path">
        <Setter Property="Fill" Value="#00EEEE" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style x:Key="PendingLineStyle" BasedOn="{StaticResource BasePendingLineStyle}" TargetType="Line">
        <Setter Property="Stroke" Value="#00EEEE" />
    </Style>
    <Style x:Key="SeparatorStyle" BasedOn="{StaticResource BaseSeparatorStyle}" TargetType="Rectangle">
        <Setter Property="Fill" Value="#287A9B" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12 0 12 8" />
    </Style>
    <Style x:Key="ItemTitleStyle" BasedOn="{StaticResource BaseItemTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D8E1DD" />
    </Style>
    <Style x:Key="ItemTitleSelectedStyle" BasedOn="{StaticResource BaseItemTitleSelectedStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D8E1DD" />
    </Style>
    <Style x:Key="ItemSubTitleStyle" BasedOn="{StaticResource BaseItemSubTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#91A5B6" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="ItemSubTitleSelectedStyle" BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6FC3DF" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="ItemNumberStyle" BasedOn="{StaticResource BaseItemNumberStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6FC3DF" />
    </Style>
    <Style x:Key="ItemGlyph" BasedOn="{StaticResource BaseGlyphStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6FC3DF" />
    </Style>
    <Style x:Key="ItemGlyphSelectedStyle" BasedOn="{StaticResource BaseGlyphSelectedStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#00EEEE" />
    </Style>
    <Style x:Key="HighlightStyle">
        <Setter Property="Inline.Foreground" Value="#FF8C1A" />
        <Setter Property="Inline.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="ItemHotkeyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#91A5B6" />
    </Style>
    <Style x:Key="ItemHotkeySelectedStyle" BasedOn="{StaticResource BaseItemHotkeySelectedStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#FF8C1A" />
    </Style>
    <Style x:Key="ThumbStyle" BasedOn="{StaticResource BaseThumbStyle}" TargetType="Thumb">
        <Setter Property="Width" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#287A9B" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarStyle" BasedOn="{StaticResource BaseScrollBarStyle}" TargetType="ScrollBar" />
    <Style x:Key="PreviewBorderStyle" BasedOn="{StaticResource BasePreviewBorderStyle}" TargetType="Border">
        <Setter Property="BorderBrush" Value="#287A9B" />
    </Style>
    <Style x:Key="PreviewItemTitleStyle" BasedOn="{StaticResource BasePreviewItemTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D8E1DD" />
    </Style>
    <Style x:Key="PreviewItemSubTitleStyle" BasedOn="{StaticResource BasePreviewItemSubTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#91A5B6" />
    </Style>
    <Style x:Key="PreviewGlyph" BasedOn="{StaticResource BasePreviewGlyph}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#00EEEE" />
    </Style>
    <Style x:Key="PreviewWindowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#101E29" />
        <Setter Property="BorderBrush" Value="#287A9B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</ResourceDictionary>
